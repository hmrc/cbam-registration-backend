# microservice specific routes

GET           /user-answers/:credId                   uk.gov.hmrc.cbamregistrationbackend.controllers.UserAnswersController.get(credId: String)
PUT           /user-answers                           uk.gov.hmrc.cbamregistrationbackend.controllers.UserAnswersController.set()
POST          /user-answers/create/:credId            uk.gov.hmrc.cbamregistrationbackend.controllers.UserAnswersController.create(credId: String)
DELETE        /user-answers/delete/:credId            uk.gov.hmrc.cbamregistrationbackend.controllers.UserAnswersController.delete(credId: String)
PUT           /user-answers/keep-alive/:credId        uk.gov.hmrc.cbamregistrationbackend.controllers.UserAnswersController.keepAlive(credId: String)
